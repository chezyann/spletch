{
  "name": "@spletch/server",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/*.test.ts",
    "compact": "tsx src/maintenance/compact-documents.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@hocuspocus/extension-database": "4.4.0",
    "@hocuspocus/server": "4.4.0",
    "argon2": "0.45.1",
    "cors": "2.8.6",
    "express": "5.1.0",
    "express-rate-limit": "8.6.1",
    "helmet": "8.1.0",
    "sharp": "0.34.4",
    "yjs": "13.6.31",
    "zod": "4.1.12",
    "@hocuspocus/extension-redis": "4.4.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
