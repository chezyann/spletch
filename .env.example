NODE_ENV=production
APP_SECRET=changez-cette-cle-avec-au-moins-32-caracteres-aleatoires
WEB_ORIGINS=https://board.example.com
COOKIE_SECURE=true
TRUST_PROXY=true
API_PORT=4000
WS_PORT=4001
DATA_DIR=/var/lib/spletch
SESSION_DAYS=7
SHARE_GRANT_HOURS=12
REALTIME_TICKET_SECONDS=90
MAX_DOCUMENT_BYTES=10485760
MAX_ELEMENTS_PER_BOARD=10000
MAX_IMAGE_BYTES=12582912
MAX_IMAGE_PIXELS=50000000
MAX_CLIENT_PDF_PAGES=30
MAX_CLIENT_PDF_DPI=300
MAX_ASSET_BYTES_PER_BOARD=524288000
MAX_BOARDS_PER_USER=100
MAX_MEMBERS_PER_BOARD=250
MAX_ACTIVE_SHARE_LINKS_PER_BOARD=20
MAX_ACTIVE_SESSIONS_PER_USER=20
MAX_REALTIME_CONNECTIONS_PER_SOURCE=12
MAX_REALTIME_CONNECTIONS_PER_BOARD=250
MAX_REALTIME_CONNECTIONS_TOTAL=2000
AUDIT_RETENTION_DAYS=365
DELETED_BOARD_RETENTION_DAYS=30
# Active la propagation entre plusieurs serveurs Hocuspocus. La base et les assets doivent alors utiliser un stockage partagé.
REDIS_HOST=
REDIS_PORT=6379
INSTANCE_NAME=spletch-1
